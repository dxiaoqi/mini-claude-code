{
  "name": "blino-agent",
  "version": "0.1.0",
  "type": "module",
  "description": "Blino — AI coding agent with web UI, tool use, MCP and visual diagram generation",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-assistant",
    "claude",
    "anthropic",
    "openai",
    "mcp",
    "tool-use",
    "blino"
  ],
  "homepage": "https://github.com/dxiaoqi/blino",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxiaoqi/blino.git"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "blino": "bin/blino.js"
  },
  "files": [
    "dist",
    "bin",
    "ui-standalone",
    "ui/skill-pack",
    "scripts/postbuild.js",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc && node scripts/postbuild.js",
    "build:web": "node scripts/build-web.js",
    "build:all": "npm run build && npm run build:web",
    "prepublishOnly": "npm run build:all",
    "dev:web": "concurrently --names \"backend,ui\" --prefix-colors \"cyan,magenta\" \"tsx src/cli.ts --serve --port 3001\" \"cd ui && npm run dev -- --port 3000\"",
    "tui": "concurrently --names \"backend,ui\" --prefix-colors \"cyan,magenta\" \"tsx src/cli.ts --serve --port 3001\" \"cd ui && npm run dev -- --port 3000\"",
    "ui": "cd ui && npm run dev -- --port 3000",
    "typecheck": "tsc --noEmit",
    "link-global": "npm link"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.4.0",
    "commander": "^13.1.0",
    "dotenv": "^17.4.1",
    "fast-glob": "^3.3.0",
    "node-html-parser": "^7.1.0",
    "openai": "^4.85.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "turndown": "^7.2.4",
    "uuid": "^11.1.0",
    "yaml": "^2.8.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.6.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^1.6.1"
  }
}
