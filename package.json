{
  "name": "mini-claude-code",
  "version": "0.1.0",
  "type": "module",
  "description": "A minimal but capable AI coding agent, inspired by Claude Code",
  "main": "dist/index.js",
  "bin": {
    "mini-claude": "bin/mini-claude.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc && node scripts/postbuild.js",
    "build:web": "cd ui && npm run build && cp -r .next/out ../web-dist 2>/dev/null || cp -r out ../web-dist 2>/dev/null || true",
    "dev:web": "concurrently --names \"backend,ui\" --prefix-colors \"cyan,magenta\" \"tsx src/cli.ts --serve --port 3001\" \"cd ui && npm run dev -- --port 3000\"",
    "tui": "concurrently --names \"backend,ui\" --prefix-colors \"cyan,magenta\" \"tsx src/cli.ts --serve --port 3001\" \"cd ui && npm run dev -- --port 3000\"",
    "ui": "cd ui && npm run dev -- --port 3000",
    "typecheck": "tsc --noEmit",
    "link-global": "npm link",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "eval": "tsx tests/eval/run.ts",
    "eval:s": "tsx tests/eval/run.ts --level S --no-llm",
    "eval:m": "tsx tests/eval/run.ts --level M --no-llm",
    "eval:l": "tsx tests/eval/run.ts --level L",
    "eval:research": "tsx tests/eval/run.ts --category research",
    "eval:quick": "tsx tests/eval/run.ts --level S --no-llm",
    "eval:full": "tsx tests/eval/run.ts",
    "eval:fixture": "tsx tests/eval/test-fixture.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.4.0",
    "commander": "^13.1.0",
    "dotenv": "^17.4.1",
    "fast-glob": "^3.3.0",
    "node-html-parser": "^7.1.0",
    "openai": "^4.85.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "turndown": "^7.2.4",
    "uuid": "^11.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.6.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^1.6.1"
  }
}
